rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /teams/{teamId}/deal-photos/{fileName} {
      // Kept simple on purpose: any signed-in user can read/write under a team's photo
      // path. Firestore rules already gate who can see the *deal* the photo is attached
      // to; a determined user could still guess another team's storage path. Tightening
      // this to verify team membership (via `firestore.exists()` cross-service checks) is
      // a reasonable hardening step once this is live — see the README.
      allow read, write: if request.auth != null;
    }
  }
}
