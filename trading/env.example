# Copy this file to .env and fill in the blanks. .env is gitignored.

# Alpaca paper trading — get keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Supabase — use the SERVICE ROLE key (Project Settings > API), not the anon
# key. The trading tables have RLS enabled with no public policies, so writes
# need the service role to bypass RLS.
SUPABASE_URL=https://ybrairokaqjoyvhqbvai.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Strategy parameters — these are the defaults, override if you want.
TICKER=AAPL
FAST_WINDOW=20
SLOW_WINDOW=50
TRADE_QTY=10
